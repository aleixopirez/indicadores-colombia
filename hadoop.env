# Configuración de Hadoop para los contenedores namenode y datanode.
# La imagen apache/hadoop convierte cada variable ARCHIVO_propiedad=valor en
# una entrada del XML correspondiente. Ejemplo:
#   CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
#   -> <property><name>fs.defaultFS</name><value>hdfs://namenode:8020</value></property>
#      dentro de core-site.xml

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

# Suplantación (proxy users): autoriza a Hive a acceder a HDFS "en nombre de"
# quien se conecta. Sin esto: "User: root is not allowed to impersonate root".
# Se autoriza a root (Spark, Python) y a hive (el usuario de HiveServer2).
# En un clúster real se limita a los hosts y grupos necesarios, no a "*".
CORE-SITE.XML_hadoop.proxyuser.root.hosts=*
CORE-SITE.XML_hadoop.proxyuser.root.groups=*
CORE-SITE.XML_hadoop.proxyuser.hive.hosts=*
CORE-SITE.XML_hadoop.proxyuser.hive.groups=*

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data

# Un solo DataNode => cada bloque se guarda una sola vez.
# En un clúster real: 3 (si un nodo cae, los datos siguen disponibles).
HDFS-SITE.XML_dfs.replication=1

# WebHDFS: la API REST que usa Python para leer y escribir sin instalar Java.
HDFS-SITE.XML_dfs.webhdfs.enabled=true

# Entorno de curso: sin control de permisos por usuario.
HDFS-SITE.XML_dfs.permissions.enabled=false

# Bloques de 32 MB (por defecto 128 MB). Con datos pequeños, bloques
# pequeños hacen visible en la interfaz web cómo HDFS divide los archivos.
HDFS-SITE.XML_dfs.blocksize=33554432
